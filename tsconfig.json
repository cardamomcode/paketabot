{
  "compilerOptions": {
    "target": "ES2024",
    // decision: declares Temporal to type-check copied Fable modules without enabling Temporal at runtime
    "lib": ["ES2024", "DOM", "ESNext.Temporal"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "build/ts",
    "outDir": "build/js",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noEmitOnError": true
  },
  "include": [
    "build/ts/app/**/*.ts",
    "build/ts/app/**/*.js"
  ]
}
