root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{fs,fsx}]
indent_style = space
indent_size = 4
fsharp_max_line_length = 120
fsharp_multiline_block_brackets_on_same_column = true
fsharp_multiline_bracket_style = stroustrup

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

